{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Assignment Manager",
  "version": "0.1.0",
  "identifier": "io.assignment-manager.desktop",
  "build": {
    "frontendDist": "../frontend",
    "additionalWatchFolders": ["../src"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Assignment Manager",
        "width": 900,
        "height": 700,
        "minWidth": 420,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
