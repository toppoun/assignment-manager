/target

# Runtime SQLite databases and sidecars (storage location is not decided yet).
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
# Allow future synthetic database fixtures; sidecars remain local-only.
!/fixtures/**/*.db
!/fixtures/**/*.sqlite
!/fixtures/**/*.sqlite3

# Local authentication traces, debug output, session dumps and secret config.
*.har
/local/
.env
.env.*
!.env.example

# Untracked authentication PoC; not a supported development tool.
/openam_probe.py
